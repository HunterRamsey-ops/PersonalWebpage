:root{--bg:#eceeed;--ink:#1c2a33;--steel:#5d6b75;--brass:#b08a3e;--panel:#fff}
@media (prefers-color-scheme:dark){:root{--bg:#1c2a33;--ink:#eceeed;--steel:#a9b5bc;--brass:#d2a94f;--panel:#25363f}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:1.05rem/1.65 Georgia,"Times New Roman",serif}
h1,h2,h3,nav,button,label,legend{font-family:"Arial Narrow","Helvetica Neue",Arial,sans-serif}
h1{font-size:clamp(2.2rem,6vw,3.6rem);line-height:1.05;margin:.2em 0;letter-spacing:-.01em}
h2{font-size:1.6rem;border-bottom:3px solid var(--brass);display:inline-block;padding-bottom:.1em}
a{color:var(--ink);text-decoration-color:var(--brass);text-underline-offset:3px}
a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--brass);outline-offset:2px}
header,main,footer{max-width:62rem;margin:0 auto;padding:1rem 1.25rem}
header{border-bottom:1px solid var(--steel)}
.brand{font:700 1.1rem Arial,sans-serif;margin:0}
nav ul{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;padding:0;margin:.6rem 0 0}
nav a{text-decoration:none;font-weight:700;padding:.2rem 0;border-bottom:3px solid transparent}
nav a[aria-current="page"],nav a:hover{border-bottom-color:var(--brass)}
.hero{display:grid;grid-template-columns:1fr 16rem;gap:2rem;align-items:center;margin:1.5rem 0}
img,video{max-width:100%;height:auto;display:block}
.hero img{border:4px solid var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1.25rem;padding:0;margin:0;list-style:none}
figure{margin:0;background:var(--panel);padding:.6rem;border-left:4px solid var(--brass)}
figcaption{font-size:.92rem;color:var(--steel);padding-top:.4rem}
form{background:var(--panel);padding:1.25rem;border-left:4px solid var(--brass);max-width:34rem}
fieldset{border:0;padding:0;margin:0 0 1rem}
label{display:block;font-weight:700;margin:.8rem 0 .2rem}
input[type=text],input[type=email],input[type=tel]{width:100%;padding:.55rem;font:inherit;border:2px solid var(--steel);background:var(--bg);color:var(--ink)}
.check{display:flex;gap:.6rem;align-items:center;margin:1rem 0}
.check label{margin:0}
button{background:var(--ink);color:var(--bg);border:0;padding:.7rem 1.5rem;font-size:1rem;font-weight:700;cursor:pointer}
button:hover{background:var(--brass);color:#1c2a33}
footer{border-top:1px solid var(--steel);margin-top:2rem;font-size:.95rem}
footer ul{list-style:none;display:flex;gap:1.2rem;padding:0;flex-wrap:wrap}
@media(max-width:640px){.hero{grid-template-columns:1fr}}
